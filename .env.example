# Composition root: demo loads fixed providers/data only from /demo; real hides demo routes.
APP_PROFILE=demo
TASK_WORKER_MAX_CONCURRENCY=4
AUDIT_GRAPH_RECURSION_LIMIT=96

# BGE-M3 与 Cross-Encoder 在部署前下载；运行时禁止因缓存探测访问外网。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Frontend -> FastAPI. Real deployments can point to the same API contract.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_CASE_BOOTSTRAP_PATH=/api/demo/cases/material_completeness
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# APP_PROFILE=demo 只从 /demo 注入固定 Case/Observation。
# APP_PROFILE=real/production 的所有 Agent、知识问答与离线上下文化共用 ModelGateway。
# 任意 OpenAI-compatible 云模型、本地 vLLM 或统一模型网关只需改配置，业务代码不变。
# LLM_ADAPTER=openai_compatible
# LLM_PROVIDER=your-provider
# LLM_BASE_URL=https://your-model-gateway.example/v1
# LLM_MODEL=<model-id>
# LLM_API_KEY=<local-secret-only>
# LLM_TIMEOUT_SECONDS=15
# LLM_MAX_RETRIES=1
# LLM_RETRY_BASE_SECONDS=0.5
# LLM_SCHEMA_RETRIES=1
# LLM_MAX_TOKENS=1200
# 带推理预算的模型可按任务角色单独扩容，避免一个全局值过小或过度浪费。
# LLM_ROLE_MAX_TOKENS_JSON={"association":8192,"audit":4096,"exception":4096,"knowledge_intent":4096,"knowledge_grounding":4096,"query_rewrite":2048,"offline_contextualization":2048,"judge":4096}
# LLM_JSON_MODE=json_object
# 结构化 Agent 建议禁用长思考；omit 表示不向 Endpoint 发送厂商扩展字段。
# LLM_THINKING_MODE=disabled
# 部分 Endpoint 建议结构化输出不传 max_tokens，避免 JSON 被截断。
# LLM_OMIT_MAX_TOKENS_FOR_STRUCTURED=false

# 可选 Fallback。Secret 使用 api_key_env 间接引用，禁止写入 JSON。
# 也可以通过 base_url_env/model_env 管理多 Endpoint 配置。
# MIMO_LLM_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_LLM_MODEL_ID=mimo-v2.5
# MIMO_LLM_API_KEY=<local-secret-only>
# LLM_FALLBACKS_JSON=[{"name":"mimo-fallback","provider":"xiaomi-mimo","base_url_env":"MIMO_LLM_BASE_URL","model_env":"MIMO_LLM_MODEL_ID","api_key_env":"MIMO_LLM_API_KEY","structured_mode":"json_object","thinking_mode":"omit","omit_max_tokens_for_structured":false,"timeout_seconds":20,"max_retries":1}]
# 可按能力配置切换链；未配置时所有任务使用 primary → 全部 fallback。
# LLM_ROUTES_JSON={"association":["primary","secondary-local"],"audit":["primary","secondary-local"],"exception":["primary","secondary-local"],"knowledge_intent":["primary"],"knowledge_grounding":["primary","secondary-local"],"query_rewrite":["primary"],"offline_contextualization":["primary","secondary-local"]}

# Real material-domain Local Tool services (required when APP_PROFILE=real).
# OCR_RETRY_SERVICE_URL=http://127.0.0.1:8101/v1/ocr/retry
# VLM_EXTRACT_SERVICE_URL=http://127.0.0.1:8102/v1/material/extract
# CASE_MATERIAL_SEARCH_URL=http://127.0.0.1:8103/v1/material/search
# PAGE_INTEGRITY_SERVICE_URL=http://127.0.0.1:8104/v1/material/page-integrity
# DOCUMENT_RELOAD_SERVICE_URL=http://127.0.0.1:8105/v1/material/reload
# MATERIAL_TOOL_TIMEOUT_MS=10000
# MATERIAL_TOOL_MAX_RETRIES=1

# Requirement RAG：应用运行时只允许真实 Milvus + BGE-M3 + Cross-Encoder。
REQUIREMENT_RAG_BACKEND=milvus
REQUIREMENT_CORPUS_PATH=.data/index_requirements.jsonl
REQUIREMENT_RAG_RRF_K=60
REQUIREMENT_RAG_MILVUS_URI=.data/material_requirements_v2_zh.milvus.db
# REQUIREMENT_RAG_MILVUS_TOKEN=
REQUIREMENT_RAG_MILVUS_COLLECTION=material_atomic_requirements
# 中文连续文本必须显式分词；修改分析器后要重建新 Collection。
REQUIREMENT_RAG_BM25_TOKENIZER=jieba
REQUIREMENT_RAG_INDEX_VERSION=requirements-v2-zh-bm25

# RAG 精确作用域缓存：memory 用于本地单进程，redis 用于跨进程。
# 本项目默认禁用近似问题的语义答案缓存，防止跨地区/产品串答。
RAG_CACHE_BACKEND=memory
# RAG_CACHE_REDIS_URL=redis://127.0.0.1:6379/0
RAG_CACHE_TTL_SECONDS=900
RAG_CACHE_VERIFY_WRITE=true
RAG_CACHE_VERSION=requirements-v2-zh-bm25
# REQUIREMENT_RAG_MILVUS_DENSE_FIELD=dense_vector
# REQUIREMENT_RAG_MILVUS_BM25_FIELD=sparse_vector
# REQUIREMENT_RAG_MILVUS_ID_FIELD=requirement_id
# REQUIREMENT_RAG_BGE_MODEL=BAAI/bge-m3
# REQUIREMENT_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# REQUIREMENT_RAG_MODEL_DEVICE=
# REQUIREMENT_RAG_USE_FP16=true
# REQUIREMENT_RAG_MILVUS_CANDIDATE_LIMIT=100
# REQUIREMENT_RAG_INDEX_BATCH_SIZE=128
# REQUIREMENT_RAG_INDEX_MANIFEST=.data/rag_index_manifest.json
# REQUIREMENT_RAG_EMBEDDING_ARTIFACT=.data/requirement_embeddings.npz
# OFFLINE_CONTEXT_MAX_TOKENS=384
# OFFLINE_CONTEXT_JOB_RETRIES=4
# OFFLINE_CONTEXT_WORKERS=3
